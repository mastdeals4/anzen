# Supabase Public Configuration (Client-side)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional Client Services
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_WHATSAPP_ADAPTER_URL=https://your-whatsapp-adapter-url.example.com

# Server-Side & Integration Test Secrets (Never commit actual values or expose to browser)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
