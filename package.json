{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "finance:repair": "node scripts/finance-historical-repair-report.mjs",
    "verify:finance-imports": "node scripts/verify-finance-import-templates.mjs",
    "verify:finance-release": "node scripts/finance-v1-release-regression.mjs",
    "verify:finance-v11": "node scripts/finance-v11-workflow-regression.mjs",
    "verify:finance-settlement": "node scripts/finance-settlement-regression.mjs",
    "verify:director-owner-accounting": "node scripts/verify-bank-recon-director-loan.mjs && node scripts/verify-director-owner-accounting.mjs",
    "verify:customs-broker-calculation": "node --experimental-strip-types scripts/verify-customs-broker-calculation.mjs",
    "verify:salary-advance-accounting": "node scripts/verify-salary-advance-accounting.mjs",
    "verify:expense-category-mappings": "node scripts/verify-expense-category-mappings.mjs",
    "verify:finance-navigation": "node scripts/verify-finance-navigation.mjs",
    "verify:money-input": "node --experimental-strip-types scripts/verify-indonesian-money-input.mjs",
    "verify:money-input-coverage": "node scripts/verify-money-input-coverage.mjs",
    "reconcile:inventory": "node scripts/inventory-stock-reconciliation.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^25.0.3",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "dompurify": "^3.3.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.3",
    "lucide-react": "^0.344.0",
    "postcss": "^8.4.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-quill": "^2.0.0",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.7.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.21",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "pg": "^8.20.0",
    "typescript-eslint": "^8.3.0"
  }
}
